<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Ağ, (Android 13+) bildirim ve yalnız QR tarayıcı için kamera izni;
         kamera izni çalışma anında, tarama ekranında istenir. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- "Anlık bildirim" (varsayılan açık): süreci arka planda canlı tutan ön
         plan hizmeti (tür specialUse; dataSync Android 15'te 24 saatte 6 saatle
         sınırlı ve açılıştan başlatılamaz) ve kullanıcı açıklamayı okuyup
         dokununca istenen pil optimizasyonu muafiyeti (Ayarlar › Bildirimler).
         Açılışta ve uygulama güncellenince hizmet (BootAlici) ve yeniden
         başlatmaya dayanıklı yoklama işi (ArkaPlanIsi, setPersisted) için
         RECEIVE_BOOT_COMPLETED. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Kamerasız cihazda da kurulur: aktarım kodu yapıştırılabilir. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Uyanık tutma: sunucu itmesi ve uyanma alarmı gelince eşitleme bitene
         dek işlemci kısa süre (en çok 30 sn) uyanık kalır; Firebase de ister. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Veri (şifreli veritabanı, anahtar kasası, önbellek) bulut yedeğine ve
         cihazlar arası aktarıma girmez. Açık metin (http) trafiği yok; yalnız
         geliştirme sürümü dev sunucusu için src/debug bildiriminde açılır. -->
    <application
        android:name=".MailhereApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Mailhere"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/veri_cikarma_kurallari"
        tools:targetApi="s">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- QR tarayıcı (bilgisayardan aktarım): yalnız MhPlugin.scanQr açar,
             ekran yönü serbest, tam ekran koyu tema; döndürmede yeniden
             oluşturulmaz (CameraX görüntüyü kendisi çevirir). -->
        <activity
            android:name=".plugin.QrScanActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.Mailhere.QrTara" />

        <!-- Açılan ve paylaşılan ekler: yalnız önbelleğin ekler/ klasörü,
             dosya başına geçici okuma izniyle (MhPlugin.kt). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.ekler"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/ekler_yollari" />
        </provider>

        <!-- Süreci temiz yeniden başlatan trampolin (ayrı süreç): anlık
             bildirim açıkken etkinlik yok edilmiş ama süreç ve çekirdek
             yaşıyorsa, uygulama yeniden açılınca MainActivity bunu başlatır;
             ana süreç öldürülür ve MainActivity yeni süreçte açılır (Tauri
             aynı süreçte ikinci bir webview kuramaz). Görünmez, son
             uygulamalarda görünmez. -->
        <activity
            android:name=".YenidenBaslatActivity"
            android:exported="false"
            android:process=":yeniden"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Bildirim düğmeleri (kullanıcının seçtiği: Yanıtla, Okundu, Arşivle,
             Sil, İstenmeyen; Geri al), kaydırıp kapatma, anlık bildirimin
             "Kapat" düğmesi ve uyanma alarmı; niyetler yalnız bu uygulamanın
             bildirimlerinden gelir. -->
        <receiver
            android:name=".plugin.BildirimAlici"
            android:exported="false" />

        <!-- Telefon yeniden başladı ya da uygulama güncellendi: yoklama işi
             zamanlanır, anlık bildirim açıksa hizmet etkinlik olmadan başlar
             (Android 12+ BOOT_COMPLETED ve MY_PACKAGE_REPLACED alıcılarına
             izin verir). Sistem yayınıdır; yalnız sistem gönderebilir. -->
        <receiver
            android:name=".plugin.BootAlici"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Yedek ağ: 15 dakikada bir, ağ varken, yeniden başlatmaya dayanıklı
             JobScheduler işi; çekirdek yoksa hizmeti başlatır ya da tek seferlik
             eşitle-bildir yapar. Yalnız sistem bağlanır (BIND_JOB_SERVICE). -->
        <service
            android:name=".plugin.ArkaPlanIsi"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- "Anlık bildirim" açıkken süreci canlı tutar (IMAP IDLE / JMAP
             anlık bildirim Rust çekirdeğinde) ve etkinlik yokken etkinliksiz
             çekirdeğin sahibidir. Görev kaydırılıp kapatılınca durmaz:
             çekirdek etkinliksiz de yaşar (Rust çıkışı engeller). -->
        <service
            android:name=".plugin.ArkaPlanHizmeti"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Kullanıcının açtığı sürekli e-posta bağlantısı (IMAP IDLE / JMAP anlık bildirim): yeni posta, sunucu bildirir bildirmez cihazda üretilen bildirimle haber verilir. Bu bağlantı cihazla posta sunucusu arasındadır; aracı sunucu kullanmaz." />
        </service>

        <!-- Sunucu itmesi (Firebase): yalnız Google Play Hizmetleri bağlanır
             (dışa kapalı; Firebase'in kendi alıcısı izinle korunur). -->
        <service
            android:name=".plugin.ItmeServisi"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- google-services yok: Firebase ayarı aktarıcıdan gelir (Itme.kt); jeton
             kendiliğinden yenilenir; Analytics ve reklam kimliği toplama kapalı. -->
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="true" />
        <meta-data android:name="firebase_analytics_collection_deactivated" android:value="true" />
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />

        <!-- Zamanlanmış bildirim kullanılmaz; açılışta geri yükleme alıcısı gereksiz. -->
        <receiver android:name="app.tauri.notification.LocalNotificationRestoreReceiver" tools:node="remove" />
    </application>
</manifest>
