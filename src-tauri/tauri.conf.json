{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mailhere",
  "mainBinaryName": "mailhere-android",
  "identifier": "com.furkanyildirim.mailhere",
  "version": "0.5.1",
  "build": {
    "beforeDevCommand": "pnpm --filter app dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter app build",
    "frontendDist": "../mailhere/app/dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: blob: https:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "frame-src": "'self' blob: data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "img-src": "'self' data: blob: https:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "frame-src": "'self' blob: data:",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:5173 http://localhost:5173",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "category": "Productivity",
    "publisher": "Furkan YILDIRIM",
    "copyright": "© 2026 Furkan YILDIRIM",
    "license": "MIT",
    "homepage": "https://github.com/fyildirim-debug/mailheremobile",
    "shortDescription": "Hızlı, sakin e-posta istemcisi",
    "longDescription": "Mailhere; masaüstü istemcisiyle aynı çekirdeği paylaşan, hızlı ve sakin bir Android e-posta istemcisidir.",
    "icon": ["icons/icon.png"],
    "android": {
      "minSdkVersion": 24,
      "versionCode": 50100
    }
  }
}
